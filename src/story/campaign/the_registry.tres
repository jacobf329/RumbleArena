[resource]
script = ExtResource("1_campaign")
title = "The Registry"
premise = "Every ninja alive is a row in the Registry: a name, a clan, and the six numbers that decide what you are permitted to do. The machine that holds it sits in the old shrine, behind a floor of server racks somebody bolted over the prayer hall.\n\nNull deleted her own row eight days ago. Since then the Registry has been rewriting everyone else's.\n\nSix floors between you and the core, and everyone on them has already been rewritten."
chapters = Array[Resource]([ExtResource("2_c1"), ExtResource("3_c2"), ExtResource("4_c3"), ExtResource("5_c4"), ExtResource("6_c5"), ExtResource("7_c6")])
