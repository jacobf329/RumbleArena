[resource]
script = ExtResource("1_chapter")
title = "Three Names Struck Out"
location = "Core antechamber"
briefing = "All three of them, and their rows are not edited now. They are deleted -- the way Null deleted hers, except nobody asked them first.\n\nA deleted ninja is not permitted to exist. They have about four minutes each to prove otherwise and they have decided to do it on you.\n\nOne stock apiece. They will not come at you one at a time."
victory = "Three names, struck out, lying down.\n\nThe antechamber door was never locked either. She has wanted you to get this far since the outer steps."
defeat = "Three of them and one room.\n\nStop standing in the middle of it."
player_stocks = 4
opponents = Array[Resource]([SubResource("Opponent_jinsoku"), SubResource("Opponent_yamabuki"), SubResource("Opponent_kurogane")])
