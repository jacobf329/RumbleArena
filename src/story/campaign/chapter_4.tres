[resource]
script = ExtResource("1_chapter")
title = "Ironjaw"
location = "The forge landing"
briefing = "Kurogane left the forge-smiths because they wanted his hands. The Registry wants the rest of him.\n\nHis row reads STRENGTH 5, TOUGHNESS 5, and a clan he walked out of nineteen years ago. He has stopped arguing with it.\n\nNothing you pick up on this landing will be light."
victory = "He goes down on one knee, then the other, then not at all.\n\nHe says one thing before the landing goes quiet. It is not the machine doing this. Somebody is asking it to."
defeat = "You traded with a man built out of a forge.\n\nDo not trade."
player_stocks = 3
opponents = Array[Resource]([SubResource("Opponent_kurogane")])
