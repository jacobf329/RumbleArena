note = "On the racks, not the floor. Comes down hard."

[resource]
script = ExtResource("1_chapter")
title = "The Rack Rows"
location = "Second gallery, between the cold aisles"
briefing = "Somebody bolted four hundred server racks over a prayer hall and left the pillars standing where they were. The Registry runs hot. The aisles run cold.\n\nTwo of them are in there and neither is themselves this morning.\n\nThere is more loose in this room than there are people in it. Pick something up."
victory = "Both down. The racks carry on as though nothing happened, which is the part that stays with you."
defeat = "Two on one, in a room you did not use.\n\nThe barrels were right there."
player_stocks = 3
opponents = Array[Resource]([SubResource("Opponent_jinsoku"), SubResource("Opponent_yamabuki")])
